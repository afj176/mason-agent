{
  "name": "mason-workspace",
  "displayName": "Mason Agent Workspace",
  "description": "Send the active editor selection and diagnostics to your local Mason workspace.",
  "publisher": "mason-agent",
  "version": "1.0.0",
  "engines": {"vscode": "^1.85.0"},
  "main": "./extension.js",
  "activationEvents": ["onCommand:mason.captureSelection", "onCommand:mason.watchTasks"],
  "contributes": {
    "commands": [{"command":"mason.captureSelection","title":"Mason: Share Selection with Local Project"},
      {"command":"mason.watchTasks","title":"Mason: Toggle Project Task Notifications"}],
    "menus": {"editor/context": [{"command":"mason.captureSelection","when":"resourceScheme == file","group":"navigation"}]}
  }
}
