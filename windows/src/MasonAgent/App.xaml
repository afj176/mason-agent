<Application x:Class="Mason.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <!-- The theme palette (ThemePalette.cs) and then Styles/Mason.xaml, whose styles use its keys, are added at startup. -->
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>

<!-- Fluent geometry: controls keep 4 px corners (ControlCornerRadius) and overlays 8 px; Mason does not override them. -->
<Style TargetType="TabView"><Setter Property="Background" Value="{ThemeResource TabViewBackground}"/></Style>
<Style TargetType="TabViewItem"><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderThickness" Value="0"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>

