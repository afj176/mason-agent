     <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#24283E"/>
     <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3B4059"/>
     <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8F6F2"/>
