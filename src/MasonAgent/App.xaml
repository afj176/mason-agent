<SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C3C2FF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#C3C2FF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C3C2FF"/><SolidColorBrush x:Key="ProgressBarForeground" Color="#C3C2FF"/><SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C3C2FF"/><SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#C3C2FF"/><SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#20263C"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#20263C"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#20263C"/>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C3C2FF"/>
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B3B2EF"/>
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#A3A2DF"/>
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#C3C2FF"/>
     <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#171A2B"/>
