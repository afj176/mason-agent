<Application x:Class="Mason.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">

<SolidColorBrush x:Key="AccentButtonBackground" Color="#4849A8"/><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#4849A8"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#4849A8"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#4849A8"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#4849A8"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#4849A8"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3E3F94"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#343580"/><SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/><SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
     <Color x:Key="SystemAccentColor">#4849A8</Color>
<SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#4849A8"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#4849A8"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#4849A8"/><SolidColorBrush x:Key="ProgressBarForeground" Color="#4849A8"/><SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4849A8"/><SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#4849A8"/><SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4849A8"/>
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3E3F94"/>
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#343580"/>
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#4849A8"/>
     <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
     <!-- brand/tokens.json: surface white, foreground ink, muted, hairline from the line token -->
     <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D9DBE1"/>
     <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#20263C"/>
