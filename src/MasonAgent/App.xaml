    <ResourceDictionary x:Key="Dark">

<SolidColorBrush x:Key="AccentButtonBackground" Color="#C3C2FF"/><SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#C3C2FF"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#C3C2FF"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#C3C2FF"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#C3C2FF"/><SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#C3C2FF"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B3B2EF"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A3A2DF"/><SolidColorBrush x:Key="AccentButtonForeground" Color="#171A2B"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#171A2B"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#171A2B"/><SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#171A2B"/>
