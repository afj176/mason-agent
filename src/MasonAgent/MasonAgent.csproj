<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><UseWinUI>true</UseWinUI><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>MasonAgent</AssemblyName><RootNamespace>Mason</RootNamespace><Version>1.8.0</Version><ApplicationIcon>Assets\Brand\app.ico</ApplicationIcon><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><Platforms>x64</Platforms><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><ApplicationManifest>app.manifest</ApplicationManifest><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
 <!-- Published builds are precompiled (ReadyToRun): the first page appears about 25% sooner for a larger payload. Native AOT is not used: reflection-based JSON is not trim-safe. -->
 <PropertyGroup Condition="'$(Configuration)' == 'Release'"><PublishReadyToRun>true</PublishReadyToRun></PropertyGroup>
 <PropertyGroup><PlaywrightPlatform>win-x64</PlaywrightPlatform></PropertyGroup>
 <ItemGroup><ProjectReference Include="../Mason.Code.Core/Mason.Code.Core.csproj" /></ItemGroup>
 <!-- Windows App SDK as its component packages rather than the Microsoft.WindowsAppSDK metapackage: the
      metapackage also brings Windows AI, ONNX Runtime and DirectML (about 42 MB) that this app never uses.
      Versions are the ones the 1.8.260921001 metapackage pins, so the runtime is unchanged. -->
 <!-- No WebView in this app. WinUI depends on the WebView2 package; excluding its assets keeps the WebView2 libraries out of the build and release. -->
 <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003"/><PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002"/><PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001"/><PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902"/><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" ExcludeAssets="all"/><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654"/><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0"/></ItemGroup>
 <ItemGroup><Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="../../scripts/ModelAdapters.json" LogicalName="Mason.ModelAdapters.json"/><Content Include="../../scripts/ModelAdapters.json" Link="model-runtime/ModelAdapters.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="../../scripts/Setup-QuantizedRuntime.py" Link="model-runtime/Setup-QuantizedRuntime.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="../../scripts/Serve-Transformers.py" Link="model-runtime/Serve-Transformers.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
 <Target Name="PublishWinUIResources" AfterTargets="Publish">
  <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI resource index was not generated." />
  <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  <Copy SourceFiles="$(TargetDir)App.xbf" DestinationFolder="$(PublishDir)" />
 </Target>
</Project>















