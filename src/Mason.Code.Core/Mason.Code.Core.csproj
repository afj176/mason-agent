<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <ProjectReference Include="../Mason.NetworkHook/Mason.NetworkHook.csproj" />
    <InternalsVisibleTo Include="Mason.CodeChecks" />
    <EmbeddedResource Include="CodeNetworkNode.cjs" LogicalName="Mason.Code.CodeNetworkNode.cjs" />
    <EmbeddedResource Include="CodeNetworkPython.py" LogicalName="Mason.Code.CodeNetworkPython.py" />
    <Content Include="../../.cache/code-compat/dbcw.dll" Link="dbcw.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../.cache/code-compat/dbcw.dll')" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../.cache/code-handoff/handoff-manifest.json')">
    <Content Include="../../.cache/code-handoff/dbcw.dll;../../.cache/code-handoff/dbck.dll;../../.cache/code-handoff/Mason.BashBootstrap.exe;../../.cache/code-handoff/handoff-manifest.json" Link="native-handoff/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
