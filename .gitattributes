* text=auto
*.ps1 text eol=crlf
*.iss text eol=crlf
*.png binary
*.gif binary
*.ico binary
*.ttf binary
*.pdf binary
*.bmp binary

# Mac and Linux sources and scripts are built on those systems and must keep Unix line endings.
macos/** text eol=lf
linux/** text eol=lf
*.sh text eol=lf
*.swift text eol=lf

# Images inside the platform folders are binary, whatever the folder-wide rule above says.
macos/**/*.png binary
linux/**/*.png binary
*.icns binary
